
# Fail on first non-zreo exit code
set -e

recursiveMkdir() {
  local _dirname=`dirname $1`
  set +e
  if ! ampy mkdir $_dirname > /dev/null 2>&1; then
    set -e
    recursiveMkdir `dirname $1`
    ampy mkdir $_dirname
  fi
}

echo Copying files from ./devicefs/ to device root
for f in `find devicefs/ -name '*.py' -o -name '*.json' -o -name '*.html' -o -name '*.js' -o -name '*.css'`; do
    ff=${f#devicefs/}
    echo "Putting: $ff";
    set +e
    if ! ampy put $f $ff > /dev/null 2>&1; then
       set -e
       echo "Creating missing directory path (`dirname $ff`) and retrying put..."
       recursiveMkdir $ff
       ampy put $f $ff
    fi
    set -e
done

mac_addr=`ampy run scripts/print_mac_address.py`
echo "Device MAC address is: $mac_addr"

echo Resetting the device
# The reset command fails with on timeout even though the reset occurs, so do
# an || true to ignore it.
ampy reset --hard > /dev/null 2>&1 || true
